# ─── Z.AI (debate engine) ────────────────────────────────────────
# Get your free API key at https://z.ai/subscribe
# Free model: glm-4.5-air (no cost, 131K context)
ZHIPU_API_KEY=your_zai_api_key_here

# ─── Supabase ─────────────────────────────────────────────────────
# Create a free project at https://supabase.com
# Copy from: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── RainbowKit / WalletConnect ──────────────────────────────────
# Free Project ID from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ─── Treasury wallet addresses (receive USDC on Base) ─────────────
# Create two dedicated wallet addresses for the treasuries
NEXT_PUBLIC_BELIEVER_TREASURY_ADDRESS=0xYourBelieverTreasuryAddress
NEXT_PUBLIC_SKEPTIC_TREASURY_ADDRESS=0xYourSkepticTreasuryAddress

# ─── Cron security ───────────────────────────────────────────────
# Optional: protect /api/debate/generate with a secret
CRON_SECRET=your_random_secret_here
